# ── STRIPE ────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Get this after setting up your webhook endpoint in Stripe dashboard
# (or use Stripe CLI: stripe listen --forward-to localhost:3001/webhook)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── SERVER ────────────────────────────────────────────────────
PORT=3001
CURRENCY=gbp

# Your deployed frontend URL (or * for local dev)
FRONTEND_URL=http://localhost:5500

# ── EMAIL (optional) ──────────────────────────────────────────
# For confirmation emails — use any SMTP provider (Resend, Postmark, Gmail etc.)
# Leave blank to skip sending emails
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_REPLACE_ME
